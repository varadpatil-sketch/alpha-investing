# Server Port
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/alpha_investing?retryWrites=true&w=majority

# Google Gemini 3.6 Flash API Key
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here
